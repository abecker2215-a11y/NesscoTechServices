# Copy this file to .env.production on the VPS and fill in real values.
# Do not commit .env* (already gitignored).

# ============================================================
# CORE INFRASTRUCTURE
# ============================================================
# Database (PostgreSQL) — required for Client Portal
DATABASE_URL=postgresql://user:pass@host:5432/msp_portal?schema=public

# NextAuth secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=https://nesscotech.com

# ============================================================
# EMAIL (Resend)
# ============================================================
# Resend API key (create at https://resend.com, add your domain and verify it first).
# Without a key, form submissions still validate but no email is sent.
RESEND_API_KEY=re_xxxxxxxx

# Where form notifications are delivered.
NOTIFY_TO=info@nesscotech.com

# Verified sender on your Resend domain. Defaults to Resend's onboarding address
# (test-only) if unset — set this for production delivery.
EMAIL_FROM=Nessco Tech Services <info@nesscotech.com>

# ============================================================
# PUBLIC SITE CONFIG
# ============================================================
# Public URL used by sitemap/canonicals (next-sitemap falls back to https://nesscotech.com).
NEXT_PUBLIC_SITE_URL=https://nesscotech.com

# Optional override for the Plausible analytics domain (defaults to the
# siteConfig domain). The snippet loads from plausible.io; self-hosted
# Plausible needs the src in src/app/layout.tsx pointed at your instance.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=nesscotech.com

# Optional: live Google reviews on the homepage (Places API → Place Details).
# Without these, the site shows curated fallback testimonials.
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACE_ID=

# Optional: real-time scheduler (Cal.com or Calendly). When unset — or still
# the repo placeholder — the site shows call/text fallbacks instead of an embed.
NEXT_PUBLIC_BOOKING_URL=https://cal.com/your-handle/intro

# ============================================================
# AZURE OPENAI (for Ask Nessco AI chat)
# ============================================================
# Get these from Azure Portal > Azure OpenAI > Keys & Endpoint.
# Without these, the chat falls back to rule-based responses.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# ============================================================
# CLIENT PORTAL (NextAuth + Prisma)
# ============================================================
# Email provider for magic links (optional - uses Resend if configured)
# EMAIL_SERVER_HOST=smtp.resend.com
# EMAIL_SERVER_PORT=587
# EMAIL_SERVER_USER=resend
# EMAIL_SERVER_PASSWORD=${RESEND_API_KEY}
# EMAIL_FROM=Nessco Tech Services <info@nesscotech.com>

# ============================================================
# PSA INTEGRATIONS (Webhooks)
# ============================================================
# ConnectWise Manage
CONNECTWISE_WEBHOOK_SECRET=your-connectwise-webhook-secret
CONNECTWISE_COMPANY_ID=
CONNECTWISE_PUBLIC_KEY=
CONNECTWISE_PRIVATE_KEY=
CONNECTWISE_BASE_URL=https://api-na.myconnectwise.net/v4_6_release/apis/3.0

# Autotask
AUTOTASK_WEBHOOK_SECRET=your-autotask-webhook-secret
AUTOTASK_USERNAME=
AUTOTASK_SECRET=
AUTOTASK_INTEGRATION_CODE=

# HaloPSA
HALOPSA_WEBHOOK_SECRET=your-halopsa-webhook-secret
HALOPSA_TENANT=
HALOPSA_CLIENT_ID=
HALOPSA_CLIENT_SECRET=
HALOPSA_BASE_URL=https://your-instance.halopsa.com/api

# ============================================================
# SCHEDULED JOBS (Cron)
# ============================================================
# Secret for /api/cron/storm-drip?secret= — hit daily from Vercel Cron,
# cron-job.org, or a container cron. Generate with: openssl rand -hex 20
CRON_SECRET=change-me-in-production# Twilio SMS (emergency pager + review nudges). Unset = email/call fallback.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
EMERGENCY_SMS_TO=

# PSA outbound sync (portal -> PSA webhook receiver)
PSA_OUTBOUND_URL=
PSA_OUTBOUND_SECRET=
PSA_OUTBOUND_SOURCE=NESSCO-PORTAL

# Google review link for post-resolution asks
GOOGLE_REVIEW_URL=
